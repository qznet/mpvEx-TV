+        int rate = (spdif_ctx->raw_bitrate / 8) / stride;   // bytes/s -> samples/s
+        if (rate > 0 && spdif_ctx->fmt &&
+            mp_aframe_get_rate(spdif_ctx->fmt) != rate)
+        {
+            mp_aframe_set_rate(spdif_ctx->fmt, rate);
+            MP_INFO(da, "direct passthrough: bitrate=%d bps -> frame rate %d\n",
+                    spdif_ctx->raw_bitrate, rate);
+        }
+
+        int emit = (spdif_ctx->raw_len / stride) * stride;
+        if (emit <= 0) {
+            drop_packet = true;
+            goto done;
+        }
+
+        out = mp_aframe_new_ref(spdif_ctx->fmt);
+        if (mp_aframe_pool_allocate(spdif_ctx->pool, out, emit / stride) < 0) {
+            TA_FREEP(&out);
+            goto done;
+        }
+        uint8_t **rawdata = mp_aframe_get_data_rw(out);
+        if (!rawdata) {
+            TA_FREEP(&out);
+            goto done;
+        }
+        memcpy(rawdata[0], spdif_ctx->raw_buf, emit);
+
+        spdif_ctx->raw_len -= emit;
+        if (spdif_ctx->raw_len)
+            memmove(spdif_ctx->raw_buf, spdif_ctx->raw_buf + emit, spdif_ctx->raw_len);
+
+        spdif_ctx->out_buffer_len = emit;
+        mp_aframe_set_pts(out, spdif_ctx->raw_pts);
+        goto done;
     }
 
     spdif_ctx->out_buffer_len  = 0;
