+// Map an mpv spdif format onto the matching Android compressed AudioTrack
+// encoding. Returns 0 when the format has no direct (non-IEC61937) equivalent.
+static jint spdif_to_direct_encoding(int format)
+{
+    switch (format) {
+    case AF_FORMAT_S_AC3:    return AudioFormat.ENCODING_AC3;
+    case AF_FORMAT_S_EAC3:   return AudioFormat.ENCODING_E_AC3;
+    case AF_FORMAT_S_DTS:    return AudioFormat.ENCODING_DTS;
+    case AF_FORMAT_S_DTSHD:  return AudioFormat.ENCODING_DTS_HD;
+    case AF_FORMAT_S_TRUEHD: return AudioFormat.ENCODING_TRUEHD;
+    default:                 return 0;
+    }
+}
